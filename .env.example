# Environment variables template for ULPF

# System Settings
APP_NAME="ULPF - Universal Log Pre-processing Framework"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://*.vercel.app,https://*.onrender.com,https://ulpf-production.up.railway.app"

# Database (Default: SQLite for zero-config local dev. Set for PostgreSQL in production)
DATABASE_URL="sqlite:///./ulpf.db"

# Frontend Environment Variable for Live Production Backend
VITE_API_BASE_URL="https://ulpf-production.up.railway.app/api"
