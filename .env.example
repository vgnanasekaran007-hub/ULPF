# Environment variables template for ULPF

# System Settings
APP_NAME="ULPF - Universal Log Pre-processing Framework"
ENVIRONMENT="development"
DEBUG=True

# Backend Server
PORT=8000
HOST="0.0.0.0"
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,https://*.vercel.app"

# Database (Default: SQLite for zero-config local dev. Set for PostgreSQL in production)
DATABASE_URL="sqlite:///./ulpf.db"
# DATABASE_URL="postgresql://ulpf_user:ulpf_password@localhost:5432/ulpf_db"

# OpenSearch (Optional / Prototype)
OPENSEARCH_URL="http://localhost:9200"

# MinIO Raw Log Bucket (Optional / Prototype)
MINIO_ENDPOINT="localhost:9000"
MINIO_ACCESS_KEY="minioadmin"
MINIO_SECRET_KEY="minioadmin"
MINIO_BUCKET="raw-logs"

# Apache Kafka (Optional / Prototype)
KAFKA_BOOTSTRAP_SERVERS="localhost:9092"
KAFKA_LOG_TOPIC="unprocessed-logs"

# Frontend Vercel Environment Variable
# VITE_API_BASE_URL="http://localhost:8000/api"
